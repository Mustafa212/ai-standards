{#-
  Resolved settings = org override, else base default.
  Use in any template file:  {% import "config/settings.jinja" as cfg with context %}
-#}
{%- import "config/defaults.jinja" as d -%}
{%- import "orgs/" ~ org ~ "/settings.jinja" as o -%}
{%- set max_function_lines = o.max_function_lines | default(d.max_function_lines) -%}
{%- set max_statements = o.max_statements | default(d.max_statements) -%}
{%- set max_complexity = o.max_complexity | default(d.max_complexity) -%}
{%- set max_params = o.max_params | default(d.max_params) -%}
{%- set max_depth = o.max_depth | default(d.max_depth) -%}
{%- set max_file_lines = o.max_file_lines | default(d.max_file_lines) -%}
{%- set coverage_target = o.coverage | default(d.coverage) -%}
{#- Adopted projects: enforce today's coverage as a floor until it reaches the target (ratchet). -#}
{%- set deferred = (deferred_checks if adopted else []) | list -%}
{%- set ratcheting = adopted and 0 < coverage_floor < coverage_target -%}
{%- set coverage = coverage_floor if ratcheting else coverage_target -%}
{%- set enforce_coverage = "coverage" not in deferred -%}
{%- set enforce_typecheck = "typecheck" not in deferred -%}
{%- set node_version = o.node_version | default(d.node_version) -%}
{%- set python_version = o.python_version | default(d.python_version) -%}
{%- set dotnet_version = o.dotnet_version | default(d.dotnet_version) -%}
{%- set banned_ts = o.banned_ts | default(d.banned_ts) -%}
{%- set banned_py = o.banned_py | default(d.banned_py) -%}
{%- set banned_cs = o.banned_cs | default(d.banned_cs) -%}
{%- set check_cmd = {"typescript": "npm run check", "python": "make check", "dotnet": "bash .ai-standards/check.sh"}[stack] -%}

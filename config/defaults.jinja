{#- Base thresholds. Orgs override any of these in orgs/<org>/settings.jinja. -#}
{%- set max_function_lines = 40 -%}
{%- set max_statements = 25 -%}
{%- set max_complexity = 10 -%}
{%- set max_params = 4 -%}
{%- set max_depth = 3 -%}
{%- set max_file_lines = 300 -%}
{%- set coverage = 80 -%}
{%- set node_version = "22" -%}
{%- set python_version = "3.12" -%}
{%- set dotnet_version = "10.0" -%}
{%- set banned_ts = {} -%}
{%- set banned_py = {} -%}
{%- set banned_cs = {} -%}

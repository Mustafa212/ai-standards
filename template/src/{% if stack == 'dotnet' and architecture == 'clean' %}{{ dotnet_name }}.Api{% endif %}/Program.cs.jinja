{% if use_cases == "mediator" %}using Mediator;
{% endif %}using {{ dotnet_name }}.Application;
{% if use_cases == "handlers" %}using {{ dotnet_name }}.Application.Common.Messaging;
{% endif %}using {{ dotnet_name }}.Application.Features.Greetings.BuildGreeting;
using {{ dotnet_name }}.Infrastructure;

WebApplicationBuilder builder = WebApplication.CreateBuilder(args);
builder.Services.AddApplication().AddInfrastructure();

WebApplication app = builder.Build();
{% if use_cases == "mediator" %}app.MapGet("/greetings/{name}", (string name, ISender sender, CancellationToken cancellationToken) =>
    sender.Send(new BuildGreetingQuery(name), cancellationToken));
{% elif use_cases == "handlers" %}app.MapGet("/greetings/{name}", (string name, IQueryHandler<BuildGreetingQuery, string> handler, CancellationToken cancellationToken) =>
    handler.HandleAsync(new BuildGreetingQuery(name), cancellationToken));
{% else %}app.MapGet("/greetings/{name}", (string name, BuildGreetingHandler handler) => handler.Handle(name));
{% endif %}
await app.RunAsync();

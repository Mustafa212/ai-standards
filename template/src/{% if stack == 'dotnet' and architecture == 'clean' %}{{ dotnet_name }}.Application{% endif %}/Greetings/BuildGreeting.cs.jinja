using {{ dotnet_name }}.Domain.Greetings;

namespace {{ dotnet_name }}.Application.Greetings;

/// <summary>Use case: the greeting shown to the user, "Good morning" before noon and "Hello" after.</summary>
public sealed class BuildGreeting(TimeProvider timeProvider)
{
    private const int NoonHour = 12;

    /// <summary>Returns the greeting for <paramref name="name"/> at the current local time.</summary>
    public string Execute(string name)
    {
        string salutation = timeProvider.GetLocalNow().Hour < NoonHour ? "Good morning" : "Hello";
        return $"{salutation}, {PersonName.From(name).Value}!";
    }
}

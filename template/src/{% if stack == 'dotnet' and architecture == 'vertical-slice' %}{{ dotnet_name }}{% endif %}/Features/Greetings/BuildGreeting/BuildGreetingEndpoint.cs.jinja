namespace {{ dotnet_name }}.Features.Greetings.BuildGreeting;

/// <summary>Wires this use case into the app: its handler and its route.</summary>
public static class BuildGreetingEndpoint
{
    /// <summary>Registers the handler of this use case.</summary>
    public static IServiceCollection AddBuildGreeting(this IServiceCollection services) =>
        services.AddSingleton<BuildGreetingHandler>();

    /// <summary>Maps <c>GET {name}</c> onto the Greetings feature's route group.</summary>
    public static RouteGroupBuilder MapBuildGreeting(this RouteGroupBuilder greetings)
    {
        greetings.MapGet("/{name}", (string name, BuildGreetingHandler handler) => handler.Handle(name));
        return greetings;
    }
}

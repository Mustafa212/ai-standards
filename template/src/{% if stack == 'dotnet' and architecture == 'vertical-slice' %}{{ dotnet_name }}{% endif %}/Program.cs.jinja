using {{ dotnet_name }}.Features.Greetings.BuildGreeting;

WebApplicationBuilder builder = WebApplication.CreateBuilder(args);
builder.Services.AddSingleton(TimeProvider.System);
builder.Services.AddBuildGreeting();

WebApplication app = builder.Build();
// One route group per feature (VSA-5): its prefix, authorization and tags live here once.
app.MapGroup("/greetings").MapBuildGreeting();

await app.RunAsync();

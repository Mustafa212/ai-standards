# Managed by ai-standards.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
{%- if stack == "dotnet" %}

# C#: rule IDs refer to AGENTS.md. `:warning` means the build fails (warnings are errors).
[*.cs]
indent_size = 4

# CS-2: layout and names
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = always:warning
# Keywords over runtime type names (CS-14) show in the IDE only: IDE0049 never runs in a build.
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_diagnostic.IDE0055.severity = warning

# CS-2: constants are PascalCase, private fields are _camelCase (the first matching rule wins)
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# CS-3: var only when the type is obvious from the right side
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# CS-4..CS-7: raised above the Recommended set
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1507.severity = warning

# DES-7: a switch expression that misses a named case fails the build (CS8509); values outside
# the enum's names throw at run time instead of forcing a catch-all arm.
dotnet_diagnostic.CS8524.severity = none
dotnet_diagnostic.S131.severity = none

# RDB-1, RDB-2, RDB-4, RDB-5 (thresholds in .ai-standards/SonarLint.xml)
dotnet_diagnostic.S107.severity = warning
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S1541.severity = warning
dotnet_diagnostic.S134.severity = warning
dotnet_diagnostic.S104.severity = warning
dotnet_diagnostic.S109.severity = warning
dotnet_diagnostic.S125.severity = warning

# Tests: literal values are the point (RDB-4 doesn't apply)
[tests/**.cs]
dotnet_diagnostic.S109.severity = none
{%- endif %}

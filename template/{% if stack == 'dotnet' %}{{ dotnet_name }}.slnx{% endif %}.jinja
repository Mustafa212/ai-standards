{%- set n = dotnet_name -%}
{%- if architecture == "clean" -%}
{%- set src = [n ~ ".Domain", n ~ ".Application", n ~ ".Infrastructure", n ~ ".Api"] -%}
{%- set tests = [n ~ ".UnitTests", n ~ ".ArchitectureTests"] -%}
{%- elif architecture == "modular-monolith" -%}
{%- set src = [n ~ ".Host", n ~ ".Modules.Greetings", n ~ ".Modules.Greetings.Contracts"] -%}
{%- set tests = [n ~ ".Tests", n ~ ".ArchitectureTests"] -%}
{%- elif architecture == "vertical-slice" -%}
{%- set src = [n] -%}
{%- set tests = [n ~ ".Tests", n ~ ".ArchitectureTests"] -%}
{%- else -%}
{%- set src = [n] -%}
{%- set tests = [n ~ ".Tests"] -%}
{%- endif -%}
<Solution>
  <Folder Name="/src/">
{%- for project in src %}
    <Project Path="src/{{ project }}/{{ project }}.csproj" />
{%- endfor %}
  </Folder>
  <Folder Name="/tests/">
{%- for project in tests %}
    <Project Path="tests/{{ project }}/{{ project }}.csproj" />
{%- endfor %}
  </Folder>
</Solution>

{% import "config/settings.jinja" as cfg with context -%}
// Managed by ai-standards. Do not edit: changes arrive through `copier update`.
//
// package.json belongs to the project and is never touched by updates (so your dependencies and
// scripts are safe). Its standard scripts just call this file, which holds everything that changes
// between standards versions: which checks run, in what order, and the tools they need.
// Usage: node .ai-standards/run.mjs <check|fix|format|format:check|lint|typecheck|test|check:deferred>
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";

const root = path.resolve(import.meta.dirname, "..");

// Tools the checks need. A missing one fails `check` with the exact install command.
const REQUIRED_DEV_DEPENDENCIES = {
{%- if stack == "angular" %}
  "@angular/build": "^22.2.2",
  "@angular/cli": "^22.2.2",
  "@angular/compiler-cli": "^22.2.0",
  "@vitest/coverage-v8": "^5.0.0",
  "angular-eslint": "^22.6.0",
  jsdom: "^30.0.0",
{%- endif %}
  "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
  "@eslint/js": "^9.15.0",
{%- if stack == "typescript" %}
  "@types/node": "^22.9.0",
  "@vitest/coverage-v8": "^3.0.0",
{%- endif %}
  eslint: "^9.24.0",
  "eslint-config-prettier": "^9.1.0",
  "eslint-plugin-jsdoc": "^65.3.2",
  prettier: "^3.3.3",
{%- if stack == "angular" %}
  typescript: "~6.0.2",
  "typescript-eslint": "^8.71.0",
  vitest: "^5.0.0",
{%- else %}
  typescript: "^5.6.3",
  "typescript-eslint": "^8.15.0",
  vitest: "^3.0.0",
{%- endif %}
};

const BINARIES = {
  prettier: ["prettier", "bin", "prettier.cjs"],
  eslint: ["eslint", "bin", "eslint.js"],
  tsc: ["typescript", "bin", "tsc"],
  vitest: ["vitest", "vitest.mjs"],
  ng: ["@angular", "cli", "bin", "ng.js"],
};

{%- if stack == "angular" %}
const TASKS = {
  format: [["prettier", "--write", "."]],
  "format:check": [["prettier", "--check", "."]],
  lint: [["eslint", ".", "--max-warnings=0"]],
  // `ng build` compiles the templates too (strictTemplates), so it is the type check.
  typecheck: [["ng", "build"]],
  test: [["ng", "test", "--watch=false"]],
  fix: [
    ["prettier", "--write", "."],
    ["eslint", ".", "--fix"],
  ],
  check: [
    ["prettier", "--check", "."],
    ["eslint", ".", "--max-warnings=0"],
    ["ng", "build"],
    ["ng", "test", "--watch=false"],
  ],
};
{%- else %}
const TASKS = {
  format: [["prettier", "--write", "."]],
  "format:check": [["prettier", "--check", "."]],
  lint: [["eslint", ".", "--max-warnings=0"]],
  typecheck: [["tsc", "--noEmit"]],
  test: [["vitest", "run", "--coverage"]],
  fix: [
    ["prettier", "--write", "."],
    ["eslint", ".", "--fix"],
  ],
  check: [
    ["prettier", "--check", "."],
    ["eslint", ".", "--max-warnings=0"],
{%- if cfg.enforce_typecheck %}
    ["tsc", "--noEmit"],
{%- endif %}
    ["vitest", "run", "--coverage"],
  ],
  // Checks this project does not pass yet (see "Adoption status" in AGENTS.md). Not enforced.
  "check:deferred": [{% if not cfg.enforce_typecheck %}["tsc", "--noEmit"]{% endif %}],
};
{%- endif %}

function missingDevDependencies() {
  const manifest = JSON.parse(readFileSync(path.join(root, "package.json"), "utf8"));
  const installed = { ...manifest.dependencies, ...manifest.devDependencies };
  return Object.entries(REQUIRED_DEV_DEPENDENCIES).filter(([name]) => !(name in installed));
}

function run([tool, ...args]) {
  const binary = path.join(root, "node_modules", ...BINARIES[tool]);
  if (!existsSync(binary)) {
    console.error(`[ai-standards] ${tool} is not installed. Run: npm install`);
    return 1;
  }
  console.error(`[ai-standards] ${tool} ${args.join(" ")}`);
  return (
    spawnSync(process.execPath, [binary, ...args], { cwd: root, stdio: "inherit" }).status ?? 1
  );
}

const task = process.argv[2] ?? "check";
if (!(task in TASKS)) {
  console.error(`[ai-standards] unknown task "${task}". Known: ${Object.keys(TASKS).join(", ")}`);
  process.exit(1);
}
if (task === "check") {
  const missing = missingDevDependencies();
  if (missing.length > 0) {
    const install = missing.map(([name, range]) => `${name}@${range}`).join(" ");
    console.error(`[ai-standards] missing dev dependencies. Run: npm install -D ${install}`);
    process.exit(1);
  }
}
for (const step of TASKS[task]) {
  const status = run(step);
  if (status !== 0) process.exit(status);
}

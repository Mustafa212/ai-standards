// Managed by ai-standards: this test is how VSA-2 and VSA-7 are enforced. Propose changes upstream.
using Assembly = System.Reflection.Assembly;
using System.Text.RegularExpressions;
using ArchUnitNET.Domain;
using ArchUnitNET.Fluent;
using ArchUnitNET.Loader;
using static ArchUnitNET.Fluent.ArchRuleDefinition;

namespace {{ dotnet_name }}.ArchitectureTests;

/// <summary>VSA-2: a feature (Features/&lt;Feature&gt;/) never depends on another feature. VSA-7: Domain/ never depends on Features/.</summary>
public sealed class FeatureIsolationTests
{
    private const string FeaturesNamespace = "{{ dotnet_name }}.Features";
    private const string DomainNamespace = "{{ dotnet_name }}.Domain";
    private static readonly Assembly _app = typeof(Program).Assembly;
    private static readonly Architecture _architecture = new ArchLoader().LoadAssemblies(_app).Build();

    [Fact]
    public void EachFeature_DependsOnNoOtherFeature()
    {
        string[] features = Features();
        foreach (string feature in features)
        {
            string[] others = [.. features.Where(other => other != feature)];
            if (others.Length > 0)
            {
                AssertNoDependency(feature, others, "depends on another feature");
            }
        }
    }

    [Fact]
    public void Domain_DependsOnNoFeature() =>
        AssertNoDependency(DomainNamespace, [FeaturesNamespace], "depends on a feature");

    private static void AssertNoDependency(string namespaceName, string[] forbidden, string problem)
    {
        ArchRule<IType> rule = Types().That().ResideInNamespaceMatching(Within([namespaceName]))
            .Should().NotDependOnAny(Types().That().ResideInNamespaceMatching(Within(forbidden)))
            // A project with no Domain/ yet passes: the rule is about what exists.
            .WithoutRequiringPositiveResults();
        string offenders = string.Join(", ", rule.Evaluate(_architecture).Where(result => !result.Passed).Select(result => result.Description));
        Assert.True(rule.HasNoViolations(_architecture), $"{namespaceName} {problem}: {offenders}");
    }

    /// <summary>These namespaces and the ones below them, as one pattern: Order doesn't take in Orders.</summary>
    private static string Within(string[] namespaces) =>
        $"^({string.Join('|', namespaces.Select(Regex.Escape))})(\\.|$)";

    /// <summary>The namespaces one level below Features: one per feature.</summary>
    private static string[] Features()
    {
        int featureDepth = FeaturesNamespace.Split('.').Length + 1;
        return [.. _app.GetTypes()
            .Select(type => type.Namespace)
            .OfType<string>()
            .Where(name => name.StartsWith(FeaturesNamespace + ".", StringComparison.Ordinal))
            .Select(name => string.Join('.', name.Split('.').Take(featureDepth)))
            .Distinct(StringComparer.Ordinal)];
    }
}

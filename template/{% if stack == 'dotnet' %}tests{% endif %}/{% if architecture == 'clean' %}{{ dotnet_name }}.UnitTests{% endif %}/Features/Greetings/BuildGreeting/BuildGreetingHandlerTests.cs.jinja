    private static readonly DateTimeOffset _morning = new(2026, 1, 1, 9, 0, 0, TimeSpan.Zero);
    private static readonly DateTimeOffset _afternoon = new(2026, 1, 1, 15, 0, 0, TimeSpan.Zero);

{% if use_cases == "plain" %}    [Fact]
    public void Handle_InTheMorning_SaysGoodMorning()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_morning));

        Assert.Equal("Good morning, Mostafa!", handler.Handle("Mostafa"));
    }

    [Fact]
    public void Handle_InTheAfternoon_SaysHello()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, Mostafa!", handler.Handle("Mostafa"));
    }

    [Fact]
    public void Handle_BlankName_GreetsTheWorld()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, world!", handler.Handle("   "));
    }
{% else %}    [Fact]
    public async Task Handle_InTheMorning_SaysGoodMorning()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_morning));

        Assert.Equal("Good morning, Mostafa!", await Greet(handler, "Mostafa"));
    }

    [Fact]
    public async Task Handle_InTheAfternoon_SaysHello()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, Mostafa!", await Greet(handler, "Mostafa"));
    }

    [Fact]
    public async Task Handle_BlankName_GreetsTheWorld()
    {
        var handler = new BuildGreetingHandler(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, world!", await Greet(handler, "   "));
    }


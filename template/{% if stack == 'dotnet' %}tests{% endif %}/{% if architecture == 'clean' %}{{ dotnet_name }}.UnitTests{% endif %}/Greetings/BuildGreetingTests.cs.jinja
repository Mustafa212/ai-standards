using {{ dotnet_name }}.Application.Greetings;

namespace {{ dotnet_name }}.UnitTests.Greetings;

public sealed class BuildGreetingTests
{
    private static readonly DateTimeOffset _morning = new(2026, 1, 1, 9, 0, 0, TimeSpan.Zero);
    private static readonly DateTimeOffset _afternoon = new(2026, 1, 1, 15, 0, 0, TimeSpan.Zero);

    [Fact]
    public void Execute_InTheMorning_SaysGoodMorning()
    {
        var greeter = new BuildGreeting(new FixedTimeProvider(_morning));

        Assert.Equal("Good morning, Mostafa!", greeter.Execute("Mostafa"));
    }

    [Fact]
    public void Execute_InTheAfternoon_SaysHello()
    {
        var greeter = new BuildGreeting(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, Mostafa!", greeter.Execute("Mostafa"));
    }

    [Fact]
    public void Execute_BlankName_GreetsTheWorld()
    {
        var greeter = new BuildGreeting(new FixedTimeProvider(_afternoon));

        Assert.Equal("Hello, world!", greeter.Execute("   "));
    }
}

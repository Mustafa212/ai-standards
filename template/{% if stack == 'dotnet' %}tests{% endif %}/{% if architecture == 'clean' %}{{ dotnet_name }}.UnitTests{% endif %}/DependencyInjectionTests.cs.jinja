{% if use_cases == "mediator" %}    [Fact]
    public async Task AddApplication_WithAClock_SendsAQueryToItsHandler()
    {
        await using ServiceProvider provider = new ServiceCollection()
            .AddSingleton(TimeProvider.System)
            .AddApplication()
            .BuildServiceProvider(validateScopes: true);
        using IServiceScope scope = provider.CreateScope();

        ISender sender = scope.ServiceProvider.GetRequiredService<ISender>();
        string greeting = await sender.Send(new BuildGreetingQuery("Mostafa"), TestContext.Current.CancellationToken);

        Assert.EndsWith("Mostafa!", greeting, StringComparison.Ordinal);
    }

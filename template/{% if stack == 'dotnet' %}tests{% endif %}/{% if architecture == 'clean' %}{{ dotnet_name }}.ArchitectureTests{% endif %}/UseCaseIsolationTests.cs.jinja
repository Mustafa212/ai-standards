using Assembly = System.Reflection.Assembly;
using System.Text.RegularExpressions;
using ArchUnitNET.Domain;
using ArchUnitNET.Fluent;
using ArchUnitNET.Loader;
using static ArchUnitNET.Fluent.ArchRuleDefinition;

namespace {{ dotnet_name }}.ArchitectureTests;

/// <summary>CLEAN-10: a use case (Application/Features/&lt;Feature&gt;/&lt;UseCase&gt;/) never calls another use case{% if use_cases == "mediator" %} or the mediator{% endif %}.</summary>
public sealed class UseCaseIsolationTests
{
    private const string FeaturesNamespace = "{{ dotnet_name }}.Application.Features";
    private static readonly Assembly _application = Assembly.Load("{{ dotnet_name }}.Application");
    private static readonly Architecture _architecture = new ArchLoader().LoadAssemblies(_application).Build();

    [Fact]
    public void EachUseCase_DependsOnNoOtherUseCase()
    {
        string[] useCases = UseCases();
        foreach (string useCase in useCases)
        {
            string[] others = [.. useCases.Where(other => other != useCase)];
            if (others.Length > 0)
            {
                AssertNoDependency(useCase, Types().That().ResideInNamespaceMatching(Within(others)), "depends on another use case");
            }
        }
    }
{% if use_cases == "mediator" %}
    [Fact]
    public void UseCases_NeverSendThroughTheMediator() =>
        AssertNoDependency(FeaturesNamespace, Types(true).That().HaveFullNameMatching(@"^Mediator\.(ISender|IMediator)$"), "sends through the mediator");
{% endif %}
    private static void AssertNoDependency(string namespaceName, IObjectProvider<IType> forbidden, string problem)
    {
        ArchRule<IType> rule = Types().That().ResideInNamespaceMatching(Within([namespaceName])).Should().NotDependOnAny(forbidden)
            .WithoutRequiringPositiveResults();
        string offenders = string.Join(", ", rule.Evaluate(_architecture).Where(result => !result.Passed).Select(result => result.Description));
        Assert.True(rule.HasNoViolations(_architecture), $"{namespaceName} {problem}: {offenders}");
    }

    /// <summary>These namespaces and the ones below them, as one pattern: BuildGreeting doesn't take in BuildGreetingTwice.</summary>
    private static string Within(string[] namespaces) =>
        $"^({string.Join('|', namespaces.Select(Regex.Escape))})(\\.|$)";

    /// <summary>The namespaces two levels below Features: one per use case.</summary>
    private static string[] UseCases()
    {
        int useCaseDepth = FeaturesNamespace.Split('.').Length + 2;
        return [.. _application.GetTypes()
            .Select(type => type.Namespace)
            .OfType<string>()
            .Where(name => name.StartsWith(FeaturesNamespace + ".", StringComparison.Ordinal))
            .Where(name => name.Split('.').Length >= useCaseDepth)
            .Select(name => string.Join('.', name.Split('.').Take(useCaseDepth)))
            .Distinct(StringComparer.Ordinal)];
    }
}

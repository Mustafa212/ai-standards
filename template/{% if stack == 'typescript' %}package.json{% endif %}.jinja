{% import "config/settings.jinja" as cfg with context -%}
{
  "name": "{{ project_slug }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">={{ cfg.node_version }}"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "node .ai-standards/run.mjs check",
    "check:deferred": "node .ai-standards/run.mjs check:deferred",
    "fix": "node .ai-standards/run.mjs fix",
    "format": "node .ai-standards/run.mjs format",
    "format:check": "node .ai-standards/run.mjs format:check",
    "lint": "node .ai-standards/run.mjs lint",
    "test": "node .ai-standards/run.mjs test",
    "typecheck": "node .ai-standards/run.mjs typecheck"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}

{%- if stack == "typescript" -%}
{%- set protect_cmd = 'node \\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-managed-files.mjs\\"' -%}
{%- set check_cmd = 'node \\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edited-file.mjs\\"' -%}
{%- else -%}
{%- set protect_cmd = 'uv run --quiet python \\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_managed_files.py\\"' -%}
{%- set check_cmd = 'uv run --quiet python \\"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edited_file.py\\"' -%}
{%- endif -%}
{
{%- if standards_source.startswith("gh:") %}
  "extraKnownMarketplaces": {
    "ai-standards": {
      "source": { "source": "github", "repo": "{{ standards_source[3:] }}" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "ai-standards@ai-standards": true
  },
{%- endif %}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ protect_cmd }}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ check_cmd }}"
          }
        ]
      }
    ]
  }
}

"""Managed by ai-standards.

Blocks AI edits to files owned by ai-standards so rules can't be weakened to "get green" (SUP-2).
A human can bypass for one session with:  AI_STANDARDS_UNLOCK=1 claude
"""

import json
import os
import sys
from fnmatch import fnmatchcase
from pathlib import Path

BLOCKING_EXIT = 2


def main() -> int:
    """Block (exit 2) an edit whose target matches .claude/managed-files.txt."""
    if os.environ.get("AI_STANDARDS_UNLOCK") == "1":
        return 0
    payload = json.loads(sys.stdin.read() or "{}")
    project = Path(os.environ.get("CLAUDE_PROJECT_DIR") or payload.get("cwd") or Path.cwd())
    raw_path = (payload.get("tool_input") or {}).get("file_path")
    managed_list = project / ".claude" / "managed-files.txt"
    if not raw_path or not managed_list.exists():
        return 0
    try:
        file = (project / raw_path).resolve().relative_to(project.resolve()).as_posix()
    except ValueError:
        return 0

    patterns = [
        line.strip()
        for line in managed_list.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if any(fnmatchcase(file, pattern) for pattern in patterns):
        sys.stderr.write(
            f"Blocked: '{file}' is managed by ai-standards (rule SUP-2).\n"
            "Fix the code instead of changing the rules. If the rule itself is wrong,\n"
            "tell the user and suggest /ai-standards:propose-rule.\n"
        )
        return BLOCKING_EXIT
    return 0


if __name__ == "__main__":
    sys.exit(main())

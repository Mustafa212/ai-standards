#!/usr/bin/env bash
# Managed by ai-standards.
# After every AI edit: auto-format + auto-fix the file, then report remaining lint errors back to
# the AI (exit 2 sends stderr to Claude so it fixes them immediately).
set -uo pipefail

input="$(cat)"
file_path="$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)"
[[ -z "$file_path" || ! -f "$file_path" ]] && exit 0

cd "${CLAUDE_PROJECT_DIR:-.}" || exit 0

report() {
  echo "Lint errors in $file_path. Fix them now (do not suppress without a reason, rule SUP-1):" >&2
  echo "$1" >&2
  exit 2
}

case "$file_path" in
{%- if stack == "typescript" %}
  *.ts|*.tsx|*.js|*.mjs|*.cjs)
    npx --no-install prettier --write --log-level warn "$file_path" >/dev/null 2>&1
    if ! output="$(npx --no-install eslint --fix --max-warnings=0 "$file_path" 2>&1)"; then
      report "$output"
    fi
    ;;
  *.json|*.md|*.yml|*.yaml|*.css)
    npx --no-install prettier --write --log-level warn "$file_path" >/dev/null 2>&1
    ;;
{%- else %}
  *.py)
    ruff="ruff"
    command -v ruff >/dev/null 2>&1 || ruff="uv run ruff"
    $ruff format --quiet "$file_path" >/dev/null 2>&1
    if ! output="$($ruff check --fix --quiet "$file_path" 2>&1)"; then
      report "$output"
    fi
    ;;
{%- endif %}
esac

exit 0

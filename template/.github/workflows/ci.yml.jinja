{% import "config/settings.jinja" as cfg with context -%}
# Managed by ai-standards. This is the gate: nothing merges unless it passes.
name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
{#- A stack's check steps. In a workspace root, run steps start in the folder (defaults.run) and
    action inputs name their files from the repo root. #}
{%- macro check_steps(project_stack, folder="") %}
      - uses: actions/checkout@v4
{%- if project_stack in ["typescript", "angular"] %}
      - uses: actions/setup-node@v4
        with:
          node-version: "{{ cfg.node_version }}"
          cache: npm
{%- if folder %}
          cache-dependency-path: {{ folder }}/package-lock.json
{%- endif %}
      - run: npm ci
      - run: npm run check
{%- elif project_stack == "flutter" %}
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
      - run: flutter pub get
      - run: bash .ai-standards/check.sh
{%- elif project_stack == "dotnet" %}
      - uses: actions/setup-dotnet@v4
        with:
          global-json-file: {{ folder ~ "/" if folder else "" }}global.json
      - run: bash .ai-standards/check.sh
{%- else %}
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ cfg.python_version }}"
      - run: uv sync
      - run: make check
{%- endif %}
{%- endmacro %}
{%- if stack == "workspace" %}
{%- for folder, project_stack in workspace_projects.items() %}
{%- if not loop.first %}
{% endif %}
  check-{{ folder | replace("/", "-") | replace(".", "-") }}:
    name: check ({{ folder }})
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{ folder }}
    steps:
{{- check_steps(project_stack, folder) }}
{%- endfor %}
{%- else %}
  check:
    runs-on: ubuntu-latest
    steps:
{{- check_steps(stack) }}
{%- endif %}
{%- if cfg.deferred %}

  # Adoption: checks the existing code does not pass yet. Visible, but not blocking.
  # Re-enable with: copier update --data 'deferred_checks=[]'  (see docs/STANDARDS-DEBT.md)
  deferred:
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
{%- if stack == "typescript" %}
      - uses: actions/setup-node@v4
        with:
          node-version: "{{ cfg.node_version }}"
          cache: npm
      - run: npm ci
{%- if not cfg.enforce_typecheck %}
      - run: npm run check:deferred
{%- endif %}
{%- if not cfg.enforce_coverage %}
      - run: npx vitest run --coverage --coverage.thresholds.lines={{ cfg.coverage_target }}
{%- endif %}
{%- elif stack == "python" %}
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ cfg.python_version }}"
      - run: uv sync
{%- if not cfg.enforce_typecheck %}
      - run: make check-deferred
{%- endif %}
{%- if not cfg.enforce_coverage %}
      - run: uv run pytest --cov-fail-under={{ cfg.coverage_target }}
{%- endif %}
{%- endif %}
{%- endif %}

  secrets:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: {{ "${{ secrets.GITHUB_TOKEN }}" }}

  commits:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: amannn/action-semantic-pull-request@v5
        env:
          GITHUB_TOKEN: {{ "${{ secrets.GITHUB_TOKEN }}" }}

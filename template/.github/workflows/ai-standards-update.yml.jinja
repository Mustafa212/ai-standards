# Managed by ai-standards.
# Once a month, pull the latest standards into this project and open a PR.
#
# Add a secret AI_STANDARDS_TOKEN (fine-grained token or GitHub App token) with Contents, Pull
# requests and Workflows read/write on THIS repo, plus read access to the standards repo if it is
# private. Without it the default GITHUB_TOKEN is used, and GitHub then refuses to push updates that
# touch .github/workflows/ (CI is managed, so many releases do) and never runs CI on the PR it opens.
name: ai-standards update

on:
  schedule:
    - cron: "17 6 1 * *"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  update:
    runs-on: ubuntu-latest
    env:
      TOKEN: {{ "${{ secrets.AI_STANDARDS_TOKEN }}" }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install copier
      - name: Warn when AI_STANDARDS_TOKEN is missing
        if: env.TOKEN == ''
        run: echo "::warning::AI_STANDARDS_TOKEN is not set, so workflow-file updates can't be pushed and CI won't run on the update PR. See the top of this workflow."
      - name: Point git at the standards repo with a token (private repos)
        if: env.TOKEN != ''
        run: git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "https://github.com/"
      - name: copier update
        run: |
          git config user.name "ai-standards-bot"
          git config user.email "ai-standards-bot@users.noreply.github.com"
          copier update --defaults --trust --conflict inline
      - name: Look for conflict markers
        id: conflicts
        run: |
          if git grep -qE '^(<<<<<<<|>>>>>>>) ' -- .; then echo "found=true" >> "$GITHUB_OUTPUT"; fi
      - uses: peter-evans/create-pull-request@v7
        with:
          token: {{ "${{ secrets.AI_STANDARDS_TOKEN || github.token }}" }}
          branch: chore/ai-standards-update
          title: "chore: update ai-standards"
          commit-message: "chore: update ai-standards"
          body: |
            Automated update from ai-standards. Read the CHANGELOG of the standards repo for what changed.
            Conflicts are left as `<<<<<<<` markers in the files: resolve them, run the checks, then merge.
      - name: Fail when conflicts are left
        if: steps.conflicts.outputs.found == 'true'
        run: |
          echo "::error::copier update left conflict markers; resolve them in the PR."
          exit 1

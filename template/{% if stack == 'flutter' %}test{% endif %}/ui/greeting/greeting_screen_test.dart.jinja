import '{{ uri }}';
{% endfor %}
import '../../fakes/fake_clock.dart';

void main() {
  testWidgets('greets the name the user types', (tester) async {
    final viewModel = GreetingViewModel(clock: FakeClock(DateTime(2026, 1, 1, 15)));
    await tester.pumpWidget(MaterialApp(home: GreetingScreen(viewModel: viewModel)));

    await tester.enterText(find.byKey(const Key('name')), 'Mostafa');
    await tester.pump();

    expect(find.text('Hello, Mostafa!'), findsOneWidget);
  });
}

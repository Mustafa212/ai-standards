# Managed by ai-standards.
# Uses uv by default. Inside an already-activated venv:  make check RUN=
RUN ?= uv run

.PHONY: check fix format-check lint typecheck test

check: format-check lint typecheck test

fix:
	$(RUN) ruff format .
	$(RUN) ruff check --fix .

format-check:
	$(RUN) ruff format --check .

lint:
	$(RUN) ruff check .

typecheck:
	$(RUN) mypy

test:
	$(RUN) pytest
